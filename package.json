	"devDependencies": {
		"@biomejs/biome": "^2.6.7",
		"@types/node": "^26.6.6",
		"dependency-cruiser": "^17.3.6",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	}
}
