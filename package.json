{
	"name": "makewhether",
	"private": true,
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@12.5.1",
	"scripts": {
		"lint": "biome check --error-on-warnings . && node scripts/check-package-graph.cjs && depcruise 'packages/**/*.{ts,mts,cts,js,mjs,cjs}' --config .dependency-cruiser.cjs",
